@model Common.Models.CommonAmenities

<script type="text/javascript" language="javascript">
    $(document).ready(function() {
        console.log("The Gym is ready!");
        M.AutoInit();
        //$('select').formSelect();
    });
</script>


<h1 align="center" style="font-family: Palace Script MT;font-size: 87px;color: #6a6a6a;">
    @if (Model.AmenityType == Common.Common.AmenityType.CommonAmenitiesMen)
    {
        <span>Men's Common Amenities</span>
    }
    else
    {
        <span>Women's Common Amenities</span>
    }
</h1>
<br />
<br />
<div align="left" style="width: 36%">
    <form asp-action="CommonAmenitiesStatusEdit" asp-controller="Amenities" method="post">
        <input asp-for="AmenityType" hidden />
        <table>
            <tr>
                <td>Health Status: </td>
                <td>
                    <div class="input-field col s12">
                        <select asp-for="Health">
                            <option value="" disabled selected>Choose Health Status</option>
                            <option value="0">OK</option>
                            <option value="1">Maintenance</option>
                            <option value="2">Issue</option>
                            <option value="3">Critical</option>
                        </select>
                        <label>Health Status</label>
                    </div>
                </td>
            </tr>
            <tr>
                <td>Last Maintenance Check: </td>
                <td>
                    <input asp-for="LastMaintenanceCheck" placeholder="Last Maintenance Check" class="validate" disabled />
                </td>
            </tr>
            <tr>
                <td>
                    <button class="btn waves-effect waves-light" type="submit" name="action">
                        Submit
                        <i class="material-icons right">edit</i>
                    </button>
                </td>
            </tr>
        </table>
    </form>

</div>