@model SocietyManagementShowcase.Models.User;
@{
	ViewData["Title"] = "Home Page";
}

<div class="text-center">
	<h1 class="display-4">Welcome</h1>
	<p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

	<form asp-action="Index" asp-controller="Home" method="post">

		<table style="width: 25%">
			<tr>
				<td>
					<input asp-for="Username" placeholder="Username" class="validate" />
				</td>
			</tr>
			<tr>
				<td>
					<input asp-for="Password" placeholder="Password" class="validate" />
				</td>
			</tr>
			@if (@ViewData["UserNotVerified"] != null && !String.IsNullOrWhiteSpace(@ViewData["UserNotVerified"].ToString()))
			{
				<tr>
					<td>
						<a class="waves-effect waves-light red darken-1 pulse btn">@ViewData["UserNotVerified"]</a>
					</td>
				</tr>
			}

			<tr>
				<td>
					<button class="btn waves-effect waves-light" type="submit" name="action">
						Login
						<i class="material-icons right">send</i>
					</button>
				</td>
			</tr>
		</table>
	</form>

	<h1>@ViewData["Message"]</h1>

</div>
