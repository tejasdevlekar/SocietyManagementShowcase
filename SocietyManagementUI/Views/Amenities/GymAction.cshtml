@using SocietyManagementShowcase.Models
@using SocietyManagementUI.Common
@model SocietyManagementShowcase.Models.Gym;

<script type="text/javascript" language="javascript">
	$(document).ready(function() {
	console.log("The Gym is ready!");
	M.AutoInit();
	$('select').formSelect();
	});
</script>

<nav>
	<div class="nav-wrapper red accent-3 z-depth-2">
		<a href="#" class="center brand-logo">Gym</a>
	</div>
</nav>

<br />
<br />
<div align="left" style="width: 36%">
	<table>
		<tr>
			<td>Health Status: </td>
			<td>
				<input asp-for="Health" placeholder="Health Status" class="validate" disabled />
			</td>
			@if (Context.Session.GetInt32(Login.USERROLETYPE) <= (int)UserRoleType.Admin)
			{
				<td>
					<a id="EditGymStatus" href="@Url.Action("GymActionEdit","Amenities")" class="btn-floating waves-effect waves-light"><i class="material-icons left">edit</i>Edit</a>
				</td>
			}
		</tr>
		<tr>
			<td>Last Maintenance Check: </td>
			<td>
				<input asp-for="LastMaintenanceCheck" placeholder="Last Maintenance Check" class="validate" disabled />
			</td>
		</tr>
	</table>
</div>

<a href="/Amenities/GymMaintenanceLog" class="waves-effect waves-light btn">Maintenance Log</a>