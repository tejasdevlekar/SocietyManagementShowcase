@model Common.Models.User;

<nav>
	<div class="nav-wrapper">
		<a href="#" class="center brand-logo">EditUser</a>
	</div>
</nav>

<div align="center">
	<form asp-action="EditUser" asp-controller="User" method="post">
		<table style="width: 25%">
			<tr>
				<td>
					<input asp-for="Username" placeholder="Username" class="validate" />
					<span asp-validation-for="Username" class="text-danger"></span>
				</td>
			</tr>
			<tr>
				<td>
					<input asp-for="Password" placeholder="Password" class="validate" />
					<span asp-validation-for="Password" class="text-danger"></span>
				</td>
			</tr>
			<tr>
				<td>
					<input asp-for="PersonId" placeholder="PersonId" class="validate" />
					<span asp-validation-for="PersonId" class="text-danger"></span>
				</td>
			</tr>

			<tr>
				<td>
					<button class="btn waves-effect waves-light" type="submit" name="action">
						Submit
						<i class="material-icons right">edit</i>
					</button>
				</td>
			</tr>
		</table>
	</form>
</div>