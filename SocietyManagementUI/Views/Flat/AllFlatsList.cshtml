@using Common.Models
@model List<AllFlatsListViewModel>

<h1 align="center" style="font-family: Palace Script MT;font-size: 87px;color: #6a6a6a;">
    Flat Management System
</h1>

<table>
    <tr>
        <td>
            Flat No
        </td>
        <td>
            Area (sq ft)
        </td>
        <td>
            Maintenance Charge
        </td>
        <td>
            Wing Name
        </td>
    </tr>
    @if (Model.Count > 0)
    {
        @foreach (AllFlatsListViewModel flat in Model)
        {
            <tr>
                <td>
                    @flat.FlatNo
                </td>
                <td>
                    @flat.AreaSqFt
                </td>
                <td>
                    @flat.MaintenanceCharge
                </td>
                <td>
                    @flat.WingName
                </td>
            </tr>
        }

        <tr>
            <td colspan="6">
                <div align="center">
                    <a href="/Flat/AllFlatsList/@(Model.FirstOrDefault().Id - 5)" class="waves-effect waves-teal btn-flat"><i class="material-icons center">chevron_left</i></a>
                    <a href="/Flat/AllFlatsList/@(Model.LastOrDefault().Id + 1)" class="waves-effect waves-teal btn-flat"><i class="material-icons center">chevron_right</i></a>
                </div>
            </td>
        </tr>
    }
</table>

