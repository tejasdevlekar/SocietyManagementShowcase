@model SocietyManagementUI.Models.SwimmingPoolActionEditViewModel;

<script type="text/javascript" language="javascript">
    $(document).ready(function() {
        console.log("The Swimming Pool is ready!");
        M.AutoInit();
    });
</script>

<nav>
    <div class="nav-wrapper red accent-3 z-depth-2">
        <a href="#" class="center brand-logo">Swimming Pool</a>
    </div>
</nav>

<br />
<br />
<div align="left" style="width: 36%">
    <form asp-action="SwimmingPoolActionEdit" asp-controller="Amenities" method="post">
        <input asp-for="PoolType" hidden/>
        <table>
            <tr>
                <td>Health Status: </td>
                <td>
                    <div class="input-field col s12">
                        <select asp-for="Health" asp-items="Model.HealthStatusItems">
                        </select>
                        <label>Health Status</label>
                    </div>
                </td>
            </tr>
            <tr>
                <td>Last Maintenance Check: </td>
                <td>
                    <input asp-for="LastMaintenanceCheck" placeholder="Last Maintenance Check" class="validate" disabled />
                </td>
            </tr>
            <tr>
                <td>
                    <button class="btn waves-effect waves-light" type="submit" name="action">
                        Submit
                        <i class="material-icons right">edit</i>
                    </button>
                </td>
            </tr>
        </table>
    </form>
</div>
