@using Common.Common
@using Common.Models;
@model List<User>;

<nav>
	<div class="nav-wrapper red accent-3">
		<a href="#" class="center brand-logo">User Management</a>
	</div>
</nav>

<table>
	<tr>
		<td>
			<h5>User Id</h5>
		</td>
		<td>
			<h5>Username</h5>
		</td>
		<td>
			<h5>Password</h5>
		</td>
		<td>
			<h5>Person Id</h5>
		</td>
	</tr>
	@foreach (User user in Model)
	{
		<tr>
			<td>@user.Id</td>
			<td>
				<h6>@user.Username</h6>
			</td>
			<td>
				<h6>@user.Password</h6>
			</td>
			<td>
				<h6>@user.PersonId</h6>
			</td>
			<td>
				<a class="btn-floating waves-effect waves-light" href="@Url.Action("EditUser","User",new {id=user.Id})"><i class="material-icons left">edit</i>Edit</a>
			</td>
			<td>
				@if (Context.Session.GetInt32(Login.USERROLETYPE) == (int)UserRoleType.SuperAdmin)
				{
					<form asp-action="DeleteUser" asp-controller="User" method="post">
						<input name="id" type="hidden" value="@user.Id" />


						<button class="btn-floating waves-effect waves-light red darken-1" type="submit" name="action">
							<i class="material-icons right">delete</i>
						</button>
					</form>
				}
			</td>
		</tr>
	}
	<tr>
		<td>
			<a href="/User/AddUser" class="waves-effect waves-light btn-large">Add User<i class="material-icons right">add</i></a>
		</td>
	</tr>
</table>


