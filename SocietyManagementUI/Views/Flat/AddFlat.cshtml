@using Common.Models
@model Common.Models.Flat;

<script type="text/javascript" language="javascript">
    $(document).ready(function() {
        console.log("Add flat is ready!");
        M.AutoInit();

          
    });


    function setData(){
        var flatData = {
            flatNo: $('#FlatNo').val(),
            areaSqFt: $('#AreaSqFt').val(),
            maintenanceCharge: $('#MaintenanceCharge').val()
        };

        flatData.residents = residentList;
        var jsonData = JSON.stringify(flatData);
        console.log("Flat data set:", flatData);
        console.log("JSON data:", jsonData);

        ajaxPost(jsonData);
    }

    

    var residentList = [];

    function SubmitPerson(){
        var personName = $('#PersonName').val()
        var personContact = $('#PersonContact').val()
        var personEmail = $('#PersonEmail').val()
        var personFlatNo = $('#PersonFlatNo').val()
        var personRoleType = $('#PersonRoleType').val()


        var Residents = {
                           "name": personName,
                           "contact": personContact,
                           "email": personEmail,
                           "flatNo": personFlatNo,
                           "role": personRoleType
                         };
        residentList.push(Residents);
        console.log(Residents);
        console.log(residentList);
        clearPerson();
        
        $('#chips').append('<div class="chip">' + Residents.name + '</div>');
        
    }

    function clearPerson(){
        $('#PersonName').val('')
        $('#PersonContact').val('')
        $('#PersonEmail').val('')
        $('#PersonFlatNo').val('')
        $('#PersonRoleType').val('')
    }

    function ajaxPost(flatData){
        $.ajax({
            type: 'POST',
            url: 'https://localhost:7249/api/Flat',
            data: JSON.stringify(flatData),
            contentType: 'application/json; charset=utf-8',
            success: function(response) {
                console.log("Flat added successfully!");
                // Optionally redirect or update UI
            },
            error: function(error) {
                console.error("Error adding flat:", error);
            }
        });
    }
</script>
<nav>
    <div class="nav-wrapper red accent-3 z-depth-2">
        <a href="#" class="center brand-logo">Add Flat</a>
    </div>
</nav>

