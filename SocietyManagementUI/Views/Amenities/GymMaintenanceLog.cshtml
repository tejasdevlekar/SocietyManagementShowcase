@using SocietyManagementShowcase.Models;
@model List<MaintenanceLog>;

<nav>
	<div class="nav-wrapper red accent-3 z-depth-2">
		<a href="#" class="center brand-logo">Gym Maintenance Log</a>
	</div>
</nav>

<table>
	<tr>
		<td>
			Id
		</td>
		<td>
			Maintenace Done By
		</td>
		<td>
			Maintenace Checked By
		</td>
		<td>
			Date And Time
		</td>
		<td>
			Reason
		</td>
		<td>
			Remarks
		</td>
	</tr>
	@foreach (MaintenanceLog log in Model)
	{
		<tr>
			<td>
				@log.Id
			</td>
			<td>
				@log.MaintenaceDoneByName
			</td>
			<td>
				@log.MaintenaceCheckedByName
			</td>
			<td>
				@log.DateAndTime
			</td>
			<td>
				@log.Reason
			</td>
			<td>
				@log.Remarks
			</td>
		</tr>
	}
	<tr>
		<td colspan="6">
			<div align="center">
				<a href="/Amenities/GymMaintenanceLog/@(Model.FirstOrDefault().Id + 5)" class="waves-effect waves-teal btn-flat"><i class="material-icons center">chevron_left</i></a>
				<a href="/Amenities/GymMaintenanceLog/@(Model.LastOrDefault().Id - 1)" class="waves-effect waves-teal btn-flat"><i class="material-icons center">chevron_right</i></a>
			</div>
		</td>
	</tr>
</table>

