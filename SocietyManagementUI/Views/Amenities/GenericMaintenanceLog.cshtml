@using Common.Common
@using Common.Models;
@model List<MaintenanceLog>;

@* <nav>
    <div class="nav-wrapper red accent-3 z-depth-2">
        <a href="#" class="center brand-logo">@Model.FirstOrDefault().LogType.ToString() Maintenance Log</a>
    </div>
</nav>
 *@


<h1 align="center" style="font-family: Palace Script MT;font-size: 87px;color: #6a6a6a;">
    @if (Model.Count > 0)
    {
        @Model.FirstOrDefault().LogType.ToString()
    }
    Maintenance Log
</h1>



<table>
    <tr>
        <td>
            Id
        </td>
        <td>
            Maintenace Done By
        </td>
        <td>
            Maintenace Checked By
        </td>
        <td>
            Date And Time
        </td>
        <td>
            Reason
        </td>
        <td>
            Remarks
        </td>
    </tr>
    @if (Model.Count > 0)
    {
        @foreach (MaintenanceLog log in Model)
        {
            <tr>
                <td>
                    @log.Id
                </td>
                <td>
                    @log.MaintenaceDoneByName
                </td>
                <td>
                    @log.MaintenaceCheckedByName
                </td>
                <td>
                    @log.DateAndTime
                </td>
                <td>
                    @log.Reason
                </td>
                <td>
                    @log.Remarks
                </td>
                @if (Context.Session.GetInt32(Login.USERROLETYPE) <= (int)UserRoleType.Admin)
                {
                    <td>
                        <a class="btn-floating waves-effect waves-light" href="@Url.Action("EditMaintenanceLog", "Amenities", new { id = log.Id, logType = log.LogType })"><i class="material-icons left">edit</i>Edit</a>
                    </td>
                }

            </tr>
        }

        <tr>
            <td colspan="6">
                <div align="center">
                    <a href="/Amenities/GenericMaintenanceLog/@(Model.FirstOrDefault().Id + 5)?type=@((int)Model.FirstOrDefault().LogType)" class="waves-effect waves-teal btn-flat"><i class="material-icons center">chevron_left</i></a>
                    <a href="/Amenities/GenericMaintenanceLog/@(Model.LastOrDefault().Id - 1)?type=@((int)Model.FirstOrDefault().LogType)" class="waves-effect waves-teal btn-flat"><i class="material-icons center">chevron_right</i></a>
                </div>
            </td>
        </tr>
    }
    else
    {
        <tr>
            <td>No data found</td>
        </tr>
    }
</table>
@if (Context.Session.GetInt32(Login.USERROLETYPE) <= (int)UserRoleType.Staff)
{
    @using Microsoft.AspNetCore.Http  

    @if (Context.Session.GetInt32(Login.USERROLETYPE) <= (int)UserRoleType.Staff)  
    {  
        var parameterName = Context.Request.Query["type"];
        <div align="right">  
            <a href="/Amenities/AddMaintenanceLog?type=@parameterName" class="waves-effect waves-light btn"><i class="material-icons right">add</i>Add Maintenance Log</a>  
        </div>  
    }
}

