@model Common.Models.MaintenanceLog;

<nav>
	<div class="nav-wrapper red accent-3 z-depth-2">
		<a href="#" class="center brand-logo">Edit Maintenance Log</a>
	</div>
</nav>

<form asp-action="EditMaintenanceLog" asp-controller="Amenities" method="post">
	<input asp-for="@Model.Id" hidden />
	<input asp-for="@Model.LogType" hidden />

<table>
	<tr>
			<td>
				Maintenace Done By
			</td>
			<td>
				<input asp-for="MaintenaceDoneByName" placeholder="Maintenace Done By Name" class="validate" />
				<span asp-validation-for="MaintenaceDoneByName" class="text-danger"></span>
			</td>
	</tr>
	<tr>
			<td>
				Maintenace Checked By
			</td>
			<td>
				<input asp-for="MaintenaceCheckedByName" placeholder="Maintenace Checked By Name" class="validate" />
				<span asp-validation-for="MaintenaceCheckedByName" class="text-danger"></span>
			</td>
	</tr>
	<tr>
			<td>
				Date And Time
			</td>
			<td>
				<input asp-for="DateAndTime" placeholder="Date And Time" class="validate" />
				<span asp-validation-for="DateAndTime" class="text-danger"></span>
			</td>
	</tr>
	<tr>
			<td>
				Reason
			</td>
			<td>
				<input asp-for="Reason" placeholder="Reason" class="validate" />
				<span asp-validation-for="Reason" class="text-danger"></span>
			</td>
	</tr>
	<tr>
			<td>
				Remarks
			</td>
			<td>
				<input asp-for="Remarks" placeholder="Remarks" class="validate" />
				<span asp-validation-for="Remarks" class="text-danger"></span>
			</td>
	</tr>
	<tr>
			<td colspan="2">
				<div align="center">
					<button class="btn waves-effect waves-light" type="submit" name="action">
						Edit Maintenance Log
						<i class="material-icons right">edit</i>
					</button>
				</div>
			</td>
	</tr>
</table>	
</form>

